# Copy to .env and provide local development values. Never commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/educore?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=educore
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-text
JWT_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
ORDER_TTL_MINUTES=30
ORDER_EXPIRATION_SCAN_MS=60000
ORDER_EXPIRATION_ENABLED=true
MESSAGING_ENABLED=true
EXAM_EXPIRATION_ENABLED=true
EXAM_EXPIRATION_SCAN_MS=60000
