<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.educore.assignment.mapper.AssignmentMapper">
    <resultMap id="assignmentViewMap" type="com.educore.assignment.entity.vo.AssignmentView">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="class_id" javaType="java.lang.Long"/>
            <arg column="class_name" javaType="java.lang.String"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="content" javaType="java.lang.String"/>
            <arg column="deadline" javaType="java.time.LocalDateTime"/>
            <arg column="status" javaType="com.educore.assignment.entity.enums.AssignmentStatus"/>
            <arg column="submission_id" javaType="java.lang.Long"/>
            <arg column="submission_content" javaType="java.lang.String"/>
            <arg column="submission_status" javaType="java.lang.String"/>
            <arg column="score" javaType="java.math.BigDecimal"/>
            <arg column="feedback" javaType="java.lang.String"/>
            <arg column="submitted_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>
    <resultMap id="submissionProgressMap" type="com.educore.assignment.entity.vo.SubmissionProgressView">
        <constructor>
            <idArg column="student_id" javaType="java.lang.Long"/>
            <arg column="student_name" javaType="java.lang.String"/>
            <arg column="submission_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="content" javaType="java.lang.String"/>
            <arg column="score" javaType="java.math.BigDecimal"/>
            <arg column="feedback" javaType="java.lang.String"/>
            <arg column="submitted_at" javaType="java.time.LocalDateTime"/>
            <arg column="graded_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>
    <resultMap id="teacherPendingAssignmentMap" type="com.educore.dashboard.entity.vo.TeacherPendingAssignmentView">
        <constructor>
            <idArg column="assignment_id" javaType="java.lang.Long"/>
            <arg column="class_id" javaType="java.lang.Long"/>
            <arg column="class_name" javaType="java.lang.String"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="student_id" javaType="java.lang.Long"/>
            <arg column="student_name" javaType="java.lang.String"/>
            <arg column="submitted_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="listStudentAssignments" resultMap="assignmentViewMap">
        SELECT a.id, a.class_id, c.name AS class_name, a.title, a.content, a.deadline, a.status,
               s.id AS submission_id, s.content AS submission_content, s.status AS submission_status,
               s.score, s.feedback, s.submitted_at
          FROM assignment a
          JOIN edu_class c ON c.id = a.class_id
          JOIN class_student cs ON cs.class_id = a.class_id AND cs.student_id = #{studentId} AND cs.status = 'ENROLLED'
          LEFT JOIN assignment_submission s ON s.assignment_id = a.id AND s.student_id = #{studentId}
         WHERE a.status = 'PUBLISHED'
         ORDER BY a.deadline, a.id
    </select>
    <select id="listProgress" resultMap="submissionProgressMap">
        SELECT u.id AS student_id, u.real_name AS student_name,
               s.id AS submission_id, s.status, s.content, s.score, s.feedback, s.submitted_at, s.graded_at
          FROM class_student cs
          JOIN sys_user u ON u.id = cs.student_id
          LEFT JOIN assignment_submission s ON s.assignment_id = #{assignmentId} AND s.student_id = cs.student_id
         WHERE cs.class_id = #{classId} AND cs.status = 'ENROLLED'
         ORDER BY u.id
    </select>
    <select id="pendingForTeacher" resultMap="teacherPendingAssignmentMap">
        SELECT a.id AS assignment_id, a.class_id, c.name AS class_name, a.title,
               s.student_id, u.real_name AS student_name, s.submitted_at
          FROM assignment_submission s
          JOIN assignment a ON a.id = s.assignment_id
          JOIN edu_class c ON c.id = a.class_id
          JOIN sys_user u ON u.id = s.student_id
         WHERE a.teacher_id = #{teacherId} AND s.status = 'SUBMITTED'
         ORDER BY s.submitted_at, a.id
         LIMIT #{limit}
    </select>
</mapper>
